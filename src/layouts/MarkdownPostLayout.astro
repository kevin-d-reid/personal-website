---
import BaseLayout from "@layouts/BaseLayout.astro";
const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={frontmatter.title}>
  <p>Published: {frontmatter.dateUploaded.toLocaleString("en-US", {dateStyle:"full",timeStyle:"short"})}</p>
  {frontmatter.dateModified && <p>Updated: {frontmatter.dateModified.toLocaleString("en-US", {dateStyle:"full",timeStyle:"short"})}</p>}
  <p><em>{frontmatter.description}</em></p>
  <p>Written by {frontmatter.author}</p>
  <img src={frontmatter.image.url} width="300" alt={frontmatter.image.alt}>

  <div class="tags">
    {frontmatter.tags.map((tag: string) => (
      <p class="tag"><a href={`/blog/tags/${tag}`}>{tag}</a></p>
    ))}
  </div>

  <slot />
</BaseLayout>